# ── Server ──────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ─────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/nex

# ── JWT ──────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES=7d

# ── Admin ────────────────────────────────────────────
ADMIN_KEY=your_admin_header_key
SEED_ADMIN_PHONE=2348012345678
SEED_ADMIN_PIN=123456
SEED_ADMIN_NAME=Admin

# ── CORS ─────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
# For multiple: FRONTEND_URLS=https://app.nex.com,https://staging.nex.com

# ── Korapay (Wallet Funding) ──────────────────────────
KORAPAY_PUBLIC_KEY=pk_live_xxxx
KORAPAY_SECRET_KEY=sk_live_xxxx
KORAPAY_WEBHOOK_SECRET=your_webhook_hmac_secret

# ── Paystack (Alternative Payment) ───────────────────
PAYSTACK_SECRET_KEY=sk_live_xxxx

# ── Peyflex (Data/Airtime Provider) ──────────────────
PEYFLEX_BASE_URL=https://api.peyflex.com
PEYFLEX_TOKEN=your_peyflex_token

# ── SMEData Provider ──────────────────────────────────
SMEDATA_BASE_URL=https://smedata.ng
SMEDATA_API_KEY=your_smedata_key

# ── Termii (OTP/SMS) ──────────────────────────────────
TERMII_API_KEY=your_termii_key
TERMII_BASE_URL=https://api.ng.termii.com
TERMII_WHATSAPP_FROM=NEX
TERMII_CHANNEL=generic

# ── Backend public URL (used in webhooks) ────────────
BACKEND_URL=https://api.nex.app

# NEX Phase 4
# Keep false until Korapay payout capability is confirmed on the merchant account.
KORAPAY_PAYOUTS_ENABLED=false
NEX_MIN_TRANSFER=100
NEX_MAX_TRANSFER=500000

# Referral rewards (adjust to protect your margin)
REFERRER_BONUS=50
REFEREE_BONUS=50
REFERRAL_MIN_TX=100

# Monetization safety
NEX_ENFORCE_NONLOSS=true

# Provider intelligence / routing
# Only list providers that support the exact service/product payload.
# Do not add a provider here unless its adapter is implemented and tested.
NEX_DATA_PROVIDERS=PEYFLEX,SMEDATA
NEX_AIRTIME_PROVIDERS=PEYFLEX
NEX_ELECTRICITY_PROVIDERS=PEYFLEX
NEX_CABLE_PROVIDERS=PEYFLEX

# Open a recommendation circuit after repeated provider failures.
NEX_PROVIDER_FAILURE_THRESHOLD=3
NEX_PROVIDER_CIRCUIT_COOLDOWN_MS=300000

# Web Push notifications (optional but recommended)
# Generate with: npx web-push generate-vapid-keys
VAPID_SUBJECT=mailto:admin@yourdomain.com
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key


# ── NEX Phase 16: critical transaction SMS fallback ───────────
# Disabled by default. Requires a funded/active Termii account.
TERMII_TRANSACTION_SMS_ENABLED=false
TERMII_SMS_FROM=NEX
TERMII_SMS_CHANNEL=generic

# ── NEX Phase 15: loyalty points ──────────────────────────────
# Default: 1 point per ₦100 spent.
LOYALTY_NAIRA_PER_POINT=100


# ── NEX Phase 18: wallet funding ─────────────────────────────
# Keep Korapay as the default active provider unless you have
# explicitly configured and verified another provider.
NEX_FUNDING_PROVIDER=KORAPAY

# Paystack can be configured as a secondary checkout provider.
# PAYSTACK_SECRET_KEY=...
# PAYSTACK_WEBHOOK_SECRET=...

# Korapay
# KORAPAY_SECRET_KEY=...
# KORAPAY_PUBLIC_KEY=...
# KORAPAY_WEBHOOK_SECRET=...

# ── Korapay Virtual Accounts ─────────────────────────
# Set to sandbox for local testing, live for production.
KORAPAY_MODE=sandbox

# Enable/disable NEX virtual accounts.
KORAPAY_VIRTUAL_ACCOUNT_ENABLED=false

# Sandbox uses 000. Production must use the bank code approved by Korapay.
KORAPAY_VIRTUAL_ACCOUNT_BANK_CODE=000

# Sandbox/test API key
KORAPAY_TEST_SECRET_KEY=sk_test_xxxx

# ── NEX Phase 20: retention streaks ─────────────────────────
NEX_STREAK_TZ=Africa/Lagos
